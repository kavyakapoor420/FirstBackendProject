<div class="relative w-full bg-slate-400 z-10 sticky top-0">
    <div class="flex w-full items-center h-24 justify-between px-4 py-4 sm:px-6 lg:px-8 border-b-2">
      <!-- Logo Section -->
      <div class="inline-flex items-center space-x-2">
        <span>
          <i class="fa-solid fa-house text-5xl text-violet-500"></i>
        </span>
        <a href="/listings" class="font-bold text-3xl text-violet-600">
            NestQuest
        </a>
      </div>
  
      <!-- Menu Items -->
      <div class="hidden lg:flex grow items-start">
        <ul class="ml-12 inline-flex space-x-8">
          <li>
            <a
              href="/listings"
              class="inline-flex items-center text-lg font-semibold text-gray-800 hover:text-gray-500"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/listings/new"
              class="inline-flex items-center text-lg font-semibold text-gray-800 hover:text-gray-500"
