<%layout('/Layouts/Boilerplate.ejs')%>

<div class="max-w-7xl mx-auto p-6">
    <!-- Listing Details -->
    <div class="bg-gray-100 shadow-lg rounded-lg overflow-hidden">
      <!-- Listing Image -->
      <img
        src="<%= listing.image %>"
        alt="<%= listing.title %>"
        class="w-full h-60 object-cover"
      />
  
      <!-- Listing Content -->
      <div class="p-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-4">
          <%= listing.title %>
        </h2>
        <p class="text-md text-gray-600 mb-4">
          <%= listing.description || "No description available" %>
        </p>
        <p class="text-lg text-blue-600 font-semibold mb-6">
          $<%= listing.price %>
        </p>
  
        <!-- Buttons -->
        <div class="flex space-x-4 mb-8">
          <a
            href="/listings/<%= listing._id %>/edit"
            class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600"
          >
            Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button
              type="submit"
              class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600"
            >
              Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  
    <!-- Review Section -->
    <div class="mt-12">
      <h3 class="text-xl font-bold text-gray-800 mb-6">Reviews</h3>
  
      <!-- Add Review Form -->
      <form
        method="POST"
        action="/listings/<%= listing._id %>/reviews"
        class="bg-gray-50 p-6 shadow-lg rounded-lg mb-12"
      >
        <label for="comment" class="block text-sm font-medium text-gray-700 mb-2">
          Comment
        </label>
        <textarea
          id="comment"
          name="comment"
          rows="4"
          class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500"
          placeholder="Write your review..."
          required
        ></textarea>
  
        <label for="rating" class="block text-sm font-medium text-gray-700 mt-4 mb-2">
          Rating
        </label>
        <div id="rating-stars" class="flex items-center space-x-2">
          <% for (let i = 1; i <= 5; i++) { %>
          <input
            type="radio"
            id="star-<%= i %>"
            name="rating"
            value="<%= i %>"
            class="hidden"
          />
          <label
            for="star-<%= i %>"
            class="cursor-pointer text-gray-300 hover:text-yellow-400"
          >
            <i class="fa-solid fa-star text-2xl"></i>
          </label>
          <% } %>
        </div>
  
        <button
          type="submit"
          class="bg-blue-500 text-white px-4 py-2 mt-6 rounded-lg hover:bg-blue-600"
        >
          Add Review
        </button>
      </form>
  
      <!-- Display Reviews -->
      <div>
        <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach(review => { %>
        <div class="bg-white shadow-lg rounded-lg p-6 mb-6">
          <p class="text-md font-medium text-gray-800 mb-2">
            <%= review.comment %>
          </p>
          <p class="text-yellow-400 text-lg">
            <% for (let i = 0; i < review.rating; i++) { %>
            <i class="fa-solid fa-star"></i>
            <% } %>
            <% for (let i = review.rating; i < 5; i++) { %>
            <i class="fa-solid fa-star text-gray-300"></i>
            <% } %>
            <span class="text-sm text-gray-600 ml-2">
              <%= review.rating %>/5
            </span>
          </p>
        </div>
        <% }); %>
        <% } else { %>
        <p class="text-gray-500">No reviews yet. Be the first to review this listing!</p>
        <% } %>
      </div>
    </div>
  </div>
  