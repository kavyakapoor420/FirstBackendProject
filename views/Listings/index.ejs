<%layout('/Layouts/Boilerplate.ejs')%>

<div class="bg-gradient-to-b from-black to-indigo-950">
  <div class="relative min-h-screen ">
     <div class="container mx-auto px-4 h-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 h-full">
         <!-- left side  -->
          <div class="flex flex-col justify-center pt-32 lg:pt-40 ml-20 mb-20 ">
            <h1 class="text-5xl lg:text-7xl font-bold text-white mb-6 tracking-tight leading-tight">
              Explore your favouitre hotels only on NestQuest 
            </h1>
            <p class="text-xl text-cyan-200 mb-8 leading-relaxed max-w-lg">
              Lorem ipsum dolor sit amet consectetur adipisicing elit. Veniam aspernatur, aperiam nobis dicta ipsa incidunt cumque officia perspiciatis! Numquam ipsum voluptat
            </p>
            <div class="flex flex-wrap">
               <button class="px-8 py-4 bg-cyan-500 text-black text-base font-semibold rounded-lg hover:bg-cyan-400 transition flex items-center">
                Nestquest
              </button>
            </div>
          </div>
          <!-- right side  -->
          <div class="relative h-[600px] lg:h-screen mr-10">
            <spline-viewer url="https://prod.spline.design/kZDDjO5HuC9GJUM2/scene.splinecode"></spline-viewer>
          </div>
        </div>
     </div>
  </div>
 
  
<div class="max-w-7xl mx-auto p-6">
    <!-- Header and Button -->
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-2xl font-bold text-gray-800">All Listings</h3>
      <form method="GET" action="/listings/new">
        <button
          class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400"
        >
          Create New Listing
        </button>
      </form>
    </div>
  
    <!-- Listings Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% for(let listing of allListings) { %>
      <!-- Card -->
      <div class="bg-slate-300 shadow-lg rounded-lg overflow-hidden flex flex-col hover:shadow-xl transition-shadow">
        <!-- Image (60%) -->
        <a
          href="/listings/<%= listing._id %>"
          class="block relative group"
        >
          <img
            src="<%= listing.image.url %>"
            alt="<%= listing.title %>"
            class="w-full h-40 sm:h-48 object-cover group-hover:opacity-75"
          />
        </a>
  
        <!-- Details Section -->
        <div class="flex-grow p-4 flex flex-col">
          <!-- Title (15%) -->
          <h4 class="text-lg font-bold text-gray-800 flex-grow">
            <%= listing.title %>
          </h4>
          
          <!-- Price (10%) -->
          <p class="text-md text-blue-600 font-semibold mt-2">
            $<%= listing.price %>
          </p>
  
          <!-- Description (15%) -->
          <p class="text-sm text-gray-600 mt-3 line-clamp-3">
            <%= listing.description || "No description available" %>
          </p>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>